# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Build / deploy scratch
site.zip
deployment.json

# Logs
*.log
npm-debug.log*

# Local env
.env
.env.local
.secret-*
.twilio

# The OpenAI key the narration generator reads. Named explicitly rather than
# left to a wildcard: a live secret is worth an unambiguous rule somebody can
# find by grepping for the filename.
openai-api-key.local
*.local

# Scratch admin-user commands. These carry board members' email addresses and
# the temporary password each account is created with, so they belong in a
# terminal or a password manager, never in a file the repository can pick up.
users.txt

# Working files: screenshots gathered for carrier and SES paperwork
signup-form.png
*.screenshot.png

# The HOA spreadsheet and anything scripts/clean-hoa-export.ps1 makes from it.
# Those files carry board members' and residents' names, phone numbers and
# home email addresses. The cleaned copy belongs beside the spreadsheet it
# came from, not in a repository the whole organization can read.
*HOAs*.txt
* - cleaned.txt

# Office lock files left behind while a document is open
~$*

# Local preview: the static server config, and the placeholder photo used to
# check the hero layout without putting a real picture in the repository.
.claude/
src/img/_preview-*

# Local preview: the stand-in for the content files the CMS publishes to S3,
# so a page can be looked at before its back end exists.
src/content/

users.txt