#!/bin/sh
# Refuse a commit message that carries a secret or personal data -- an error
# message pasted in with someone's address in it, say. The pre-commit hook
# checks what is committed; this checks what is said about it. Same rules.
#
# Turned on by the same `git config core.hooksPath .githooks`. Git passes
# the path of the message file as $1. This hook also runs for `git merge`,
# where pre-commit doesn't, so it checks for itself that it can run.

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "commit-msg: gitleaks is not installed, so this message was not checked." >&2
    exit 1
fi
for config in .gitleaks.toml .gitleaks-standard.toml; do
    if [ ! -f "$config" ]; then
        echo "commit-msg: $config is missing, so this message was not checked." >&2
        exit 1
    fi
done

# Only the message git will record. `git commit -v` puts the diff in the
# file below a scissors line ("# ---- >8 ----"); without cutting it off, a
# commit that *removes* an address would be refused for the address it
# removes. Comment lines are dropped too -- unless commit.cleanup keeps
# them, in which case they are part of the message and are checked.
case "$(git config commit.cleanup || true)" in
    verbatim|whitespace) strip="" ;;
    *)                   strip="--strip-comments" ;;
esac
message=$(sed '/^. -\{24\} >8 -\{24\}$/,$d' "$1" | git stripspace $strip)

for config in .gitleaks.toml .gitleaks-standard.toml; do
    if ! printf '%s\n' "$message" \
            | gitleaks stdin -c "$config" --ignore-gitleaks-allow --redact --no-banner --verbose; then
        echo "commit-msg: the message above names something it shouldn't." >&2
        echo "Your message is saved in $1; edit it and commit again." >&2
        exit 1
    fi
done
