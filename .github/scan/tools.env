# Pinned versions and SHA-256 checksums of the scanners that are downloaded
# as release files. Read by .github/scripts/install-scanner.sh.
#
# Pinned for the same reason actions are pinned by SHA: this decides what code
# runs in the workflow. Each checksum was checked against two records: for
# GitHub releases, GitHub's own record of the file and the project's published
# checksums; for exiftool, CPAN's CHECKSUMS file and a download. Choose
# releases at least seven days old, as Dependabot's cooldown does for actions.
# Dependabot doesn't move these; how to is in .github/scan/README.md.
#
# The Python scanners are pinned with hashes in .github/scan/requirements/.

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

TRUFFLEHOG_VERSION=3.99.7
TRUFFLEHOG_SHA256=bdbea0508e439b144f49de14e775908de5f902f3d14ea7ae8354bae72b0b72ef

# From CPAN, which keeps every release; exiftool.org keeps only the newest.
EXIFTOOL_VERSION=13.55
EXIFTOOL_SHA256=5f4c81d34ad406538c2871ad72dbfceb5d9b412b2f16cbbeb4d712d270846667
